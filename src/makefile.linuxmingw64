# Makefile for cross-compiling Sd/Sdtty for 64-bit Windows on Ubuntu using
# mingw-w64. This assumes the x86_64-w64-mingw32 toolchain is installed.
# (Generated by Gemini from makefile.linux64 and makefile.mingw64.)

# Toolchain definitions for 64-bit
CROSS_PREFIX = x86_64-w64-mingw32-
CXX = $(CROSS_PREFIX)g++
CC = $(CROSS_PREFIX)gcc
WINDRES = $(CROSS_PREFIX)windres
STRIP = $(CROSS_PREFIX)strip

# Host compiler for building helper tools during the build process
HOST_CXX = g++

# Compiler flags
# Based on makefile.mingw64
DEFS = -Wall -Wno-switch -Wno-uninitialized -Wno-char-subscripts -Wno-narrowing
CDEBUGFLAGS = -O4
CXXFLAGS = $(CDEBUGFLAGS) $(DEFS) -static -static-libgcc -static-libstdc++

# Library flags
SDTTY_LIBS = -L. -lsdlib
SD_LIBS = -lcomctl32 -L. -lsdlib

SDLIB_OBJS = sdmain.o sdutil.o sdbasic.o sdinit.o \
             sdtables.o sdctable.o sdtop.o sdconcpt.o sdpreds.o \
             sdgetout.o sdmoves.o sdtand.o sdconc.o sdistort.o \
             mapcachefile.o sdpick.o sdsi.o sdmatch.o common.o

SDTTY_OBJS = sdui-tty.o sdui-wincon.o
SD_OBJS = sdprint.o sdui-win.o
MKCALLS_OBJS = mkcalls.o common.o

all: sdtty.exe sd.exe mkcalls.exe sd_calls.dat

libsdlib.a: sdlib.dll

sdlib.dll: $(SDLIB_OBJS)
	$(CXX) $(CXXFLAGS) -shared -o sdlib.dll -Wl,--out-implib,libsdlib.a $(SDLIB_OBJS)
	$(STRIP) sdlib.dll

sdres.o: sd.rc
	$(WINDRES) sd.rc sdres.o

sdttyres.o: sdtty.rc
	$(WINDRES) sdtty.rc sdttyres.o

mkcalls.exe: $(MKCALLS_OBJS)
	$(CXX) $(CXXFLAGS) -mconsole -o $@ $(MKCALLS_OBJS)
	$(STRIP) mkcalls.exe

sdtty.exe: libsdlib.a sdlib.dll $(SDTTY_OBJS) sdttyres.o
	$(CXX) $(CXXFLAGS) -mconsole -o $@ $(SDTTY_OBJS) sdttyres.o $(SDTTY_LIBS)
	$(STRIP) sdtty.exe

sd.exe: libsdlib.a sdlib.dll $(SD_OBJS) sdres.o
	$(CXX) $(CXXFLAGS) -mwindows -o $@ $(SD_OBJS) sdres.o $(SD_LIBS)
	$(STRIP) sd.exe

# To generate sd_calls.dat, we need a native version of mkcalls
mkcalls_native: mkcalls.cpp common.cpp
	$(HOST_CXX) -O2 -o mkcalls_native mkcalls.cpp common.cpp

sd_calls.dat: sd_calls.txt mkcalls_native
	./mkcalls_native ./sd_calls.txt

.SUFFIXES: .c .cpp

# Our general compile rule is for sdlib.
.c.o:
	$(CC) $(CXXFLAGS) -DSDLIB_EXPORTS -c $<

.cpp.o:
	$(CXX) $(CXXFLAGS) -DSDLIB_EXPORTS -c $<

# The files for the top-level programs have explicit rules
# without "-DSDLIB_EXPORTS".

mkcalls.o: mkcalls.cpp
	$(CXX) $(CXXFLAGS) -c $<

common.o: common.cpp
	$(CXX) $(CXXFLAGS) -c $<

sdui-tty.o: sdui-tty.cpp
	$(CXX) $(CXXFLAGS) -c $<

sdui-win.o: sdui-win.cpp
	$(CXX) $(CXXFLAGS) -Wno-array-bounds -c $<

sdui-wincon.o: sdui-wincon.cpp
	$(CXX) $(CXXFLAGS) -c $<

sdprint.o: sdprint.cpp
	$(CXX) $(CXXFLAGS) -c $<

# Miscellaneous file dependencies.
sd.h sdui.h: database.h sdchars.h
mkcalls.o sdmain.o sdsi.o: paths.h
common.o mkcalls.o: database.h
sdinit.cpp: mapcachefile.h sort.h
sdui-win.o: sdprint.h
mapcachefile.cpp: mapcachefile.h
sdprint.o: sdprint.h
$(SDLIB_OBJS) $(SDTTY_OBJS): sdui.h sd.h sdchars.h sdmatch.h database.h paths.h

clean:
	rm -f *.o sd.exe sdtty.exe mkcalls.exe mkcalls_native sdlib.dll libsdlib.a sd_calls.dat
