# codespell settings for scripts/check-spelling.sh, which also chooses the files
# to check (SPELL_FILES in scripts/checks.conf).
[codespell]
# en-GB_to_en-US enforces American spelling; clear and rare catch typos.
builtin = clear,rare,en-GB_to_en-US
# .codespell-dictionary.txt adds British words the builtins miss; the trailing
# "-" keeps the builtins in force.
dictionary = .codespell-dictionary.txt,-
# thar: a square dance term ("allemande thar"), not a misspelling of "that".
# Anything else stays reportable: silence a single line with a trailing
# "codespell:ignore <word>" comment instead of widening this list.
ignore-words-list = thar
# 35 = 1 + 2 + 32: say nothing about the Latin-1 web pages in doc/, binary
# files, or the configuration files read.
quiet-level = 35
# The lines of upstream text whose misspellings predate this check. A line
# listed here is skipped wherever it appears; scripts/check-spelling.sh
# --update-baseline regenerates the list.
exclude-file = scripts/codespell-baseline.txt
